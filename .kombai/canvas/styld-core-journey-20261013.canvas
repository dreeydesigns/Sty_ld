      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');\n:root{--styld-ink:#1D1D1B;--styld-clay:#C0A090;--styld-sage:#909888;--styld-page:#FAF8F5;--styld-paper:#FFFFFF;--styld-raised:#F4F1EC;--styld-muted:#4F4B48;--styld-line:rgba(29,29,27,.14);--styld-sans:'DM Sans',sans-serif;--styld-display:'Playfair Display',Georgia,serif}\n</style>\n<div class=\"min-h-screen bg-[var(--styld-page)] font-[var(--styld-sans)] text-[var(--styld-ink)] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"mx-auto flex max-w-[440px] items-center justify-between border-b border-[var(--styld-line)] px-5 py-4\" data-kid=\"1-1\" data-name=\"site header bar\">\n        <div class=\"font-[var(--styld-display)] text-[25px] font-semibold tracking-[-0.04em]\" data-kid=\"1-1-1\" data-name=\"brand wordmark logo\">\n            Styld\n            <span class=\"text-[var(--styld-clay)]\" data-kid=\"1-1-1-1\" data-name=\"brand accent dot\">\n                .\n            </span>\n        </div>\n        <div class=\"flex items-center gap-3 text-[13px] font-medium\" data-kid=\"1-1-2\" data-name=\"location and sign-in area\">\n            <span class=\"text-[var(--styld-muted)]\" data-kid=\"1-1-2-1\" data-name=\"city location label\">\n                Nairobi\n            </span>\n            <button class=\"rounded-full border border-[var(--styld-line)] px-4 py-2 text-[var(--styld-ink)]\" data-kid=\"1-1-2-2\" data-name=\"sign-in button\">\n                Sign in\n            </button>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[440px] px-5 pb-10\" data-kid=\"1-2\" data-name=\"main content container\">\n        <section class=\"pt-5\" data-kid=\"1-2-1\" data-name=\"hero section\">\n            <figure class=\"m-0 overflow-hidden rounded-[18px] bg-[var(--styld-raised)]\" data-kid=\"1-2-1-1\" data-name=\"hero inspiration figure card\">\n                <div class=\"relative h-[276px] w-full overflow-hidden\" data-kid=\"1-2-1-1-1\" data-name=\"hero image container\">\n                    <img alt=\"Black woman with golden braids against a warm yellow background. Photo by Kehinde Ogunsanya on Pexels.\" class=\"h-full w-full object-cover object-[center_28%]\" data-kid=\"1-2-1-1-1-1\" data-name=\"hero inspiration photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/11515382/pexels-photo-11515382.jpeg?auto=compress&cs=tinysrgb&w=900&h=1100&fit=crop&q=80\"/>\n                    <div class=\"absolute bottom-3 left-3 rounded-full bg-[var(--styld-page)]/95 px-3 py-1.5 text-[11px] font-semibold text-[var(--styld-ink)]\" data-kid=\"1-2-1-1-1-2\" data-name=\"image caption pill\">\n                        Braids & protective styles\n                    </div>\n                </div>\n                <figcaption class=\"flex items-center justify-between px-3 py-2 text-[10px] text-[var(--styld-muted)]\" data-kid=\"1-2-1-1-2\" data-name=\"figure metadata caption\">\n                    <span data-kid=\"1-2-1-1-2-1\" data-name=\"inspiration category label\">\n                        Style inspiration\n                    </span>\n                    <span data-kid=\"1-2-1-1-2-2\" data-name=\"photo credit text\">\n                        Pexels / Kehinde Ogunsanya\n                    </span>\n                </figcaption>\n            </figure>\n            <div class=\"pt-5\" data-kid=\"1-2-1-2\" data-name=\"hero headline and actions block\">\n                <h1 class=\"max-w-[330px] font-[var(--styld-display)] text-[35px] font-semibold leading-[1.05] tracking-[-0.04em]\" data-kid=\"1-2-1-2-1\" data-name=\"hero headline text\">\n                    Find a look.\n                    <br data-kid=\"1-2-1-2-1-1\" data-name=\"line break\"/>\n                    Meet its maker.\n                </h1>\n                <p class=\"mt-3 max-w-[320px] text-[14px] leading-[1.65] text-[var(--styld-muted)]\" data-kid=\"1-2-1-2-2\" data-name=\"hero supporting paragraph\">\n                    Browse beauty work, compare service details and see who offers it before you book.\n                </p>\n                <button class=\"mt-5 flex min-h-[50px] w-full items-center justify-between rounded-full bg-[var(--styld-ink)] px-5 text-[14px] font-semibold text-white\" data-kid=\"1-2-1-2-3\" data-name=\"primary browse-looks call-to-action button\">\n                    <span data-kid=\"1-2-1-2-3-1\" data-name=\"button label text\">\n                        Browse looks\n                    </span>\n                    <span aria-hidden=\"true\" class=\"text-[19px] font-normal\" data-kid=\"1-2-1-2-3-2\" data-name=\"right arrow icon\">\n                        →\n                    </span>\n                </button>\n                <p class=\"mt-2 text-center text-[11px] text-[var(--styld-muted)]\" data-kid=\"1-2-1-2-4\" data-name=\"hero secondary note text\">\n                    Explore first. Sign in only when you’re ready to book.\n                </p>\n            </div>\n        </section>\n        <section class=\"mt-11 border-t border-[var(--styld-line)] pt-6\" data-kid=\"1-2-2\" data-name=\"audience onboarding section\">\n            <h2 class=\"font-[var(--styld-display)] text-[24px] font-semibold leading-tight tracking-[-0.025em]\" data-kid=\"1-2-2-1\" data-name=\"onboarding section heading\">\n                What brings you here?\n            </h2>\n            <div class=\"mt-4 divide-y divide-[var(--styld-line)]\" data-kid=\"1-2-2-2\" data-name=\"audience option list container\">\n                <div class=\"flex items-start justify-between gap-4 py-4\" data-kid=\"1-2-2-2-1\" data-name=\"looking-for-service option row\">\n                    <div data-kid=\"1-2-2-2-1-1\" data-name=\"option description block\">\n                        <p class=\"text-[14px] font-semibold\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"option title text\">\n                            I’m looking for a service\n                        </p>\n                        <p class=\"mt-1 text-[12px] leading-5 text-[var(--styld-muted)]\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"option description text\">\n                            Compare looks, providers and listed prices.\n                        </p>\n                    </div>\n                    <button class=\"mt-1 shrink-0 text-[13px] font-semibold\" data-kid=\"1-2-2-2-1-2\" data-name=\"browse option action button\">\n                        Browse\n                        <span aria-hidden=\"true\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"right arrow icon\">\n                            →\n                        </span>\n                    </button>\n                </div>\n                <div class=\"flex items-start justify-between gap-4 py-4\" data-kid=\"1-2-2-2-2\" data-name=\"run-a-salon option row\">\n                    <div data-kid=\"1-2-2-2-2-1\" data-name=\"option description block\">\n                        <p class=\"text-[14px] font-semibold\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"option title text\">\n                            I run a salon\n                        </p>\n                        <p class=\"mt-1 text-[12px] leading-5 text-[var(--styld-muted)]\" data-kid=\"1-2-2-2-2-1-2\" data-name=\"option description text\">\n                            Show your team, service menu and work.\n                        </p>\n                    </div>\n                    <button class=\"mt-1 shrink-0 text-[13px] font-semibold\" data-kid=\"1-2-2-2-2-2\" data-name=\"list-salon action button\">\n                        List salon\n                        <span aria-hidden=\"true\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"right arrow icon\">\n                            →\n                        </span>\n                    </button>\n                </div>\n                <div class=\"flex items-start justify-between gap-4 py-4\" data-kid=\"1-2-2-2-3\" data-name=\"beauty-professional option row\">\n                    <div data-kid=\"1-2-2-2-3-1\" data-name=\"option description block\">\n                        <p class=\"text-[14px] font-semibold\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"option title text\">\n                            I’m a beauty professional\n                        </p>\n                        <p class=\"mt-1 text-[12px] leading-5 text-[var(--styld-muted)]\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"option description text\">\n                            Build a profile with your work and services.\n                        </p>\n                    </div>\n                    <button class=\"mt-1 shrink-0 text-[13px] font-semibold\" data-kid=\"1-2-2-2-3-2\" data-name=\"join-styld action button\">\n                        Join Styld\n                        <span aria-hidden=\"true\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"right arrow icon\">\n                            →\n                        </span>\n                    </button>\n                </div>\n            </div>\n        </section>\n        <section class=\"mt-8 rounded-[18px] bg-[var(--styld-raised)] px-4 py-5\" data-kid=\"1-2-3\" data-name=\"booking-steps section\">\n            <h2 class=\"font-[var(--styld-display)] text-[23px] font-semibold leading-tight tracking-[-0.025em]\" data-kid=\"1-2-3-1\" data-name=\"booking-steps heading\">\n                A booking in five steps\n            </h2>\n            <p class=\"mt-2 text-[12px] leading-5 text-[var(--styld-muted)]\" data-kid=\"1-2-3-2\" data-name=\"booking-steps intro text\">\n                See the service and its details before you decide.\n            </p>\n            <ol class=\"mt-5\" data-kid=\"1-2-3-3\" data-name=\"step list container\">\n                <li class=\"relative flex gap-3 pb-4\" data-kid=\"1-2-3-3-1\" data-name=\"step one row\">\n                    <span class=\"relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[var(--styld-ink)] text-[11px] font-semibold text-white\" data-kid=\"1-2-3-3-1-1\" data-name=\"step one number badge\">\n                        1\n                    </span>\n                    <span class=\"absolute left-[13px] top-7 h-[calc(100%-20px)] w-px bg-[var(--styld-clay)]\" data-kid=\"1-2-3-3-1-2\" data-name=\"step one connecting line\">\n                    </span>\n                    <div class=\"pt-0.5\" data-kid=\"1-2-3-3-1-3\" data-name=\"step one description block\">\n                        <p class=\"text-[13px] font-semibold\" data-kid=\"1-2-3-3-1-3-1\" data-name=\"step one title text\">\n                            Choose a salon or professional\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] leading-4 text-[var(--styld-muted)]\" data-kid=\"1-2-3-3-1-3-2\" data-name=\"step one description text\">\n                            Start with a look or a maker.\n                        </p>\n                    </div>\n                </li>\n                <li class=\"relative flex gap-3 pb-4\" data-kid=\"1-2-3-3-2\" data-name=\"step two row\">\n                    <span class=\"relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[var(--styld-clay)] bg-[var(--styld-page)] text-[11px] font-semibold\" data-kid=\"1-2-3-3-2-1\" data-name=\"step two number badge\">\n                        2\n                    </span>\n                    <span class=\"absolute left-[13px] top-7 h-[calc(100%-20px)] w-px bg-[var(--styld-clay)]\" data-kid=\"1-2-3-3-2-2\" data-name=\"step two connecting line\">\n                    </span>\n                    <div class=\"pt-0.5\" data-kid=\"1-2-3-3-2-3\" data-name=\"step two description block\">\n                        <p class=\"text-[13px] font-semibold\" data-kid=\"1-2-3-3-2-3-1\" data-name=\"step two title text\">\n                            Select a service\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] leading-4 text-[var(--styld-muted)]\" data-kid=\"1-2-3-3-2-3-2\" data-name=\"step two description text\">\n                            Check what’s included and the starting price.\n                        </p>\n                    </div>\n                </li>\n                <li class=\"relative flex gap-3 pb-4\" data-kid=\"1-2-3-3-3\" data-name=\"step three row\">\n                    <span class=\"relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[var(--styld-clay)] bg-[var(--styld-page)] text-[11px] font-semibold\" data-kid=\"1-2-3-3-3-1\" data-name=\"step three number badge\">\n                        3\n                    </span>\n                    <span class=\"absolute left-[13px] top-7 h-[calc(100%-20px)] w-px bg-[var(--styld-clay)]\" data-kid=\"1-2-3-3-3-2\" data-name=\"step three connecting line\">\n                    </span>\n                    <div class=\"pt-0.5\" data-kid=\"1-2-3-3-3-3\" data-name=\"step three description block\">\n                        <p class=\"text-[13px] font-semibold\" data-kid=\"1-2-3-3-3-3-1\" data-name=\"step three title text\">\n                            Choose a time\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] leading-4 text-[var(--styld-muted)]\" data-kid=\"1-2-3-3-3-3-2\" data-name=\"step three description text\">\n                            Check the booking calendar for available times.\n                        </p>\n                    </div>\n                </li>\n                <li class=\"relative flex gap-3 pb-4\" data-kid=\"1-2-3-3-4\" data-name=\"step four row\">\n                    <span class=\"relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[var(--styld-clay)] bg-[var(--styld-page)] text-[11px] font-semibold\" data-kid=\"1-2-3-3-4-1\" data-name=\"step four number badge\">\n                        4\n                    </span>\n                    <span class=\"absolute left-[13px] top-7 h-[calc(100%-20px)] w-px bg-[var(--styld-clay)]\" data-kid=\"1-2-3-3-4-2\" data-name=\"step four connecting line\">\n                    </span>\n                    <div class=\"pt-0.5\" data-kid=\"1-2-3-3-4-3\" data-name=\"step four description block\">\n                        <p class=\"text-[13px] font-semibold\" data-kid=\"1-2-3-3-4-3-1\" data-name=\"step four title text\">\n                            Review the details\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] leading-4 text-[var(--styld-muted)]\" data-kid=\"1-2-3-3-4-3-2\" data-name=\"step four description text\">\n                            Confirm service, location, timing and total.\n                        </p>\n                    </div>\n                </li>\n                <li class=\"flex gap-3\" data-kid=\"1-2-3-3-5\" data-name=\"step five row\">\n                    <span class=\"relative z-10 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[var(--styld-clay)] bg-[var(--styld-page)] text-[11px] font-semibold\" data-kid=\"1-2-3-3-5-1\" data-name=\"step five number badge\">\n                        5\n                    </span>\n                    <div class=\"pt-0.5\" data-kid=\"1-2-3-3-5-2\" data-name=\"step five description block\">\n                        <p class=\"text-[13px] font-semibold\" data-kid=\"1-2-3-3-5-2-1\" data-name=\"step five title text\">\n                            Confirm your booking\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] leading-4 text-[var(--styld-muted)]\" data-kid=\"1-2-3-3-5-2-2\" data-name=\"step five description text\">\n                            Review payment and booking terms before you confirm.\n                        </p>\n                    </div>\n                </li>\n            </ol>\n        </section>\n        <section class=\"mt-8 border-t border-[var(--styld-line)] pt-6\" data-kid=\"1-2-4\" data-name=\"transparency notes section\">\n            <h2 class=\"font-[var(--styld-display)] text-[23px] font-semibold leading-tight tracking-[-0.025em]\" data-kid=\"1-2-4-1\" data-name=\"transparency section heading\">\n                Know what you’re choosing\n            </h2>\n            <div class=\"mt-4 space-y-4\" data-kid=\"1-2-4-2\" data-name=\"transparency notes container\">\n                <div class=\"flex gap-3\" data-kid=\"1-2-4-2-1\" data-name=\"first note row\">\n                    <span class=\"mt-1 h-2 w-2 shrink-0 rounded-full bg-[var(--styld-sage)]\" data-kid=\"1-2-4-2-1-1\" data-name=\"note bullet dot\">\n                    </span>\n                    <p class=\"text-[13px] leading-5\" data-kid=\"1-2-4-2-1-2\" data-name=\"first note text\">\n                        <strong class=\"font-semibold\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"first note lead-in emphasis\">\n                            Compare the listing.\n                        </strong>\n                        Review the provider, service, starting price, duration and service mode.\n                    </p>\n                </div>\n                <div class=\"flex gap-3\" data-kid=\"1-2-4-2-2\" data-name=\"second note row\">\n                    <span class=\"mt-1 h-2 w-2 shrink-0 rounded-full bg-[var(--styld-sage)]\" data-kid=\"1-2-4-2-2-1\" data-name=\"note bullet dot\">\n                    </span>\n                    <p class=\"text-[13px] leading-5\" data-kid=\"1-2-4-2-2-2\" data-name=\"second note text\">\n                        <strong class=\"font-semibold\" data-kid=\"1-2-4-2-2-2-1\" data-name=\"second note lead-in emphasis\">\n                            Check the calendar.\n                        </strong>\n                        Appointment times are shown in the booking flow, not assumed from a sample listing.\n                    </p>\n                </div>\n                <div class=\"flex gap-3\" data-kid=\"1-2-4-2-3\" data-name=\"third note row\">\n                    <span class=\"mt-1 h-2 w-2 shrink-0 rounded-full bg-[var(--styld-sage)]\" data-kid=\"1-2-4-2-3-1\" data-name=\"note bullet dot\">\n                    </span>\n                    <p class=\"text-[13px] leading-5\" data-kid=\"1-2-4-2-3-2\" data-name=\"third note text\">\n                        <strong class=\"font-semibold\" data-kid=\"1-2-4-2-3-2-1\" data-name=\"third note lead-in emphasis\">\n                            Review before confirming.\n                        </strong>\n                        Browsing does not place a booking or take payment; review the final terms in the booking flow.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"mt-9 border-t border-[var(--styld-line)] pt-6\" data-kid=\"1-2-5\" data-name=\"closing call-to-action section\">\n            <p class=\"max-w-[300px] font-[var(--styld-display)] text-[25px] font-semibold leading-tight tracking-[-0.03em]\" data-kid=\"1-2-5-1\" data-name=\"closing headline text\">\n                Choose your next beauty service with the details in view.\n            </p>\n            <button class=\"mt-4 flex min-h-[48px] w-full items-center justify-center gap-2 rounded-full bg-[var(--styld-ink)] px-5 text-[13px] font-semibold text-white\" data-kid=\"1-2-5-2\" data-name=\"closing browse-looks button\">\n                Browse looks\n                <span aria-hidden=\"true\" data-kid=\"1-2-5-2-1\" data-name=\"right arrow icon\">\n                    →\n                </span>\n            </button>\n        </section>\n    </main>\n    <footer class=\"border-t border-[var(--styld-line)] bg-[var(--styld-ink)] px-5 py-6 text-white\" data-kid=\"1-3\" data-name=\"site footer bar\">\n        <div class=\"mx-auto flex max-w-[400px] items-start justify-between gap-4\" data-kid=\"1-3-1\" data-name=\"footer content container\">\n            <div data-kid=\"1-3-1-1\" data-name=\"footer brand block\">\n                <p class=\"font-[var(--styld-display)] text-[21px] font-semibold\" data-kid=\"1-3-1-1-1\" data-name=\"footer wordmark text\">\n                    Styld.\n                </p>\n                <p class=\"mt-1 text-[11px] text-white/75\" data-kid=\"1-3-1-1-2\" data-name=\"footer tagline text\">\n                    Beauty services across Nairobi.\n                </p>\n            </div>\n            <div class=\"flex gap-4 pt-1 text-[11px] text-white/85\" data-kid=\"1-3-1-2\" data-name=\"footer navigation links\">\n                <span data-kid=\"1-3-1-2-1\" data-name=\"help link label\">\n                    Help\n                </span>\n                <span data-kid=\"1-3-1-2-2\" data-name=\"privacy link label\">\n                    Privacy\n                </span>\n                <span data-kid=\"1-3-1-2-3\" data-name=\"terms link label\">\n                    Terms\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n",
      "comments": [],
