        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');\n</style>\n<main class=\"min-h-[940px] bg-[#FAF8F5] px-4 pb-8 text-[#1D1D1B] [font-family:'DM_Sans',sans-serif]\" data-kid=\"1\" data-name=\"page main container\">\n    <header class=\"mx-auto flex h-[68px] max-w-[375px] items-center justify-between border-b border-[#1D1D1B]/10\" data-kid=\"1-1\" data-name=\"top header bar\">\n        <a aria-label=\"Back to browsing\" class=\"inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-[#4F4B48]\" data-kid=\"1-1-1\" data-name=\"back to browsing link\" href=\"/discover\">\n            <span aria-hidden=\"true\" class=\"text-lg leading-none\" data-kid=\"1-1-1-1\" data-name=\"left arrow back icon\">\n                ←\n            </span>\n            <span data-kid=\"1-1-1-2\" data-name=\"back link label text\">\n                Back to browsing\n            </span>\n        </a>\n        <a class=\"text-[27px] font-semibold tracking-[-0.06em] text-[#1D1D1B] [font-family:'Playfair_Display',Georgia,serif]\" data-kid=\"1-1-2\" data-name=\"site logo wordmark link\" href=\"/\">\n            Styld\n            <span class=\"text-[#909888]\" data-kid=\"1-1-2-1\" data-name=\"logo accent dot\">\n                .\n            </span>\n        </a>\n        <span class=\"w-[114px]\" data-kid=\"1-1-3\" data-name=\"header spacer for logo alignment\">\n        </span>\n    </header>\n    <section class=\"mx-auto mt-8 w-full max-w-[343px] overflow-hidden rounded-[22px] border border-[#1D1D1B]/12 bg-white\" data-kid=\"1-2\" data-name=\"booking sign-in card\">\n        <div class=\"p-5 pb-4\" data-kid=\"1-2-1\" data-name=\"booking summary section\">\n            <p class=\"mb-3 text-[11px] font-semibold uppercase tracking-[0.14em] text-[#6E6966]\" data-kid=\"1-2-1-1\" data-name=\"booking section label\">\n                Continue booking\n            </p>\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-1-2\" data-name=\"booking detail row\">\n                <img alt=\"Black woman with golden braids against a warm yellow background — Pexels / Kehinde Ogunsanya\" class=\"h-[76px] w-[62px] shrink-0 rounded-[9px] object-cover object-[center_28%]\" data-kid=\"1-2-1-2-1\" data-name=\"stylist profile thumbnail image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/11515382/pexels-photo-11515382.jpeg?auto=compress&cs=tinysrgb&w=240&h=300&fit=crop\"/>\n                <div class=\"min-w-0\" data-kid=\"1-2-1-2-2\" data-name=\"booking detail text container\">\n                    <h2 class=\"text-[17px] font-semibold leading-[1.25] text-[#1D1D1B]\" data-kid=\"1-2-1-2-2-1\" data-name=\"service title headline\">\n                        Medium Boho Knotless Braids\n                    </h2>\n                    <p class=\"mt-1.5 text-[13px] leading-5 text-[#4F4B48]\" data-kid=\"1-2-1-2-2-2\" data-name=\"stylist name and location line\">\n                        Njeri Kamau\n                        <span class=\"text-[#909888]\" data-kid=\"1-2-1-2-2-2-1\" data-name=\"stylist name and location separator dot\">\n                            ·\n                        </span>\n                        Kilimani\n                    </p>\n                    <p class=\"mt-1 text-[13px] font-semibold text-[#1D1D1B]\" data-kid=\"1-2-1-2-2-3\" data-name=\"service starting price text\">\n                        From KES 4,500\n                    </p>\n                </div>\n            </div>\n            <p class=\"mt-3 rounded-md bg-[#F4F1EC] px-3 py-2 text-[12px] leading-[1.45] text-[#4F4B48]\" data-kid=\"1-2-1-3\" data-name=\"booking status notice box\">\n                No appointment time is held yet. You can check times after signing in.\n            </p>\n        </div>\n        <div class=\"h-px bg-[#1D1D1B]/10\" data-kid=\"1-2-2\" data-name=\"section divider line\">\n        </div>\n        <div class=\"p-5 pt-5\" data-kid=\"1-2-3\" data-name=\"sign-in form section\">\n            <h1 class=\"text-[29px] font-semibold leading-[1.12] tracking-[-0.035em] text-[#1D1D1B] [font-family:'Playfair_Display',Georgia,serif]\" data-kid=\"1-2-3-1\" data-name=\"sign-in section headline\">\n                Sign in to continue\n            </h1>\n            <p class=\"mt-2.5 text-[14px] leading-[1.55] text-[#4F4B48]\" data-kid=\"1-2-3-2\" data-name=\"sign-in method description\">\n                We’ll email you a six-digit code. No password to remember.\n            </p>\n            <form class=\"mt-5\" data-kid=\"1-2-3-3\" data-name=\"email sign-in form\">\n                <label class=\"mb-2 block text-[13px] font-semibold text-[#1D1D1B]\" data-kid=\"1-2-3-3-1\" data-name=\"email input label\" for=\"email\">\n                    Email address\n                </label>\n                <input autocomplete=\"email\" class=\"h-[52px] w-full rounded-[10px] border border-[#1D1D1B]/25 bg-white px-3.5 text-[15px] text-[#1D1D1B] placeholder:text-[#6E6966] focus:border-[#875945] focus:outline-none focus:ring-2 focus:ring-[#C0A090]/40\" data-kid=\"1-2-3-3-2\" data-name=\"email address input field\" id=\"email\" inputmode=\"email\" placeholder=\"you@example.com\" type=\"email\"/>\n                <button class=\"mt-3 flex h-[52px] w-full items-center justify-center gap-2 rounded-full bg-[#1D1D1B] px-5 text-[14px] font-semibold text-white\" data-kid=\"1-2-3-3-3\" data-name=\"send sign-in code button\" type=\"button\">\n                    Send sign-in code\n                    <span aria-hidden=\"true\" class=\"text-base\" data-kid=\"1-2-3-3-3-1\" data-name=\"button forward arrow icon\">\n                        →\n                    </span>\n                </button>\n            </form>\n            <p class=\"mt-4 text-[12px] leading-[1.5] text-[#4F4B48]\" data-kid=\"1-2-3-4\" data-name=\"email privacy note text\">\n                Your email stays private. Sign-in activity helps protect your account.\n            </p>\n            <p class=\"mt-3 text-[12px] leading-[1.55] text-[#4F4B48]\" data-kid=\"1-2-3-5\" data-name=\"legal terms and privacy consent text\">\n                By continuing, you agree to our\n                <a class=\"font-semibold text-[#875945] underline decoration-[#875945]/50 underline-offset-2\" data-kid=\"1-2-3-5-1\" data-name=\"terms of service link\" href=\"/legal/terms\">\n                    Terms\n                </a>\n                and\n                <a class=\"font-semibold text-[#875945] underline decoration-[#875945]/50 underline-offset-2\" data-kid=\"1-2-3-5-2\" data-name=\"privacy policy link\" href=\"/legal/privacy\">\n                    Privacy Policy\n                </a>\n                .\n            </p>\n            <div class=\"mt-5 border-t border-[#1D1D1B]/10 pt-4 text-center\" data-kid=\"1-2-3-6\" data-name=\"guest and help options area\">\n                <a class=\"inline-flex min-h-10 items-center justify-center text-[14px] font-semibold text-[#1D1D1B] underline decoration-[#C0A090] underline-offset-4\" data-kid=\"1-2-3-6-1\" data-name=\"continue as guest link\" href=\"/discover\">\n                    Continue browsing as a guest\n                </a>\n                <p class=\"mt-3 text-[12px] text-[#4F4B48]\" data-kid=\"1-2-3-6-2\" data-name=\"can't access email help text\">\n                    Can’t access your email?\n                    <a class=\"font-semibold text-[#875945] underline underline-offset-2\" data-kid=\"1-2-3-6-2-1\" data-name=\"get help link\" href=\"/help\">\n                        Get help\n                    </a>\n                </p>\n            </div>\n        </div>\n    </section>\n    <p class=\"mx-auto mt-6 max-w-[315px] text-center text-[12px] leading-5 text-[#6E6966]\" data-kid=\"1-3\" data-name=\"post-card booking disclaimer text\">\n        Your look is ready to continue. Sign-in does not reserve a time or confirm a booking.\n    </p>\n    <footer class=\"mx-auto mt-10 flex max-w-[343px] items-center justify-center gap-2 text-[11px] text-[#6E6966]\" data-kid=\"1-4\" data-name=\"footer location line\">\n        <span data-kid=\"1-4-1\" data-name=\"brand name footer text\">\n            STYLD\n        </span>\n        <span aria-hidden=\"true\" class=\"text-[#909888]\" data-kid=\"1-4-2\" data-name=\"footer separator dot\">\n            ·\n        </span>\n        <span data-kid=\"1-4-3\" data-name=\"city name footer text\">\n            Nairobi\n        </span>\n        <span aria-hidden=\"true\" class=\"text-[#909888]\" data-kid=\"1-4-4\" data-name=\"footer separator dot\">\n            ·\n        </span>\n        <span data-kid=\"1-4-5\" data-name=\"service category footer text\">\n            Beauty booking\n        </span>\n    </footer>\n</main>\n",
      "comments": [],
