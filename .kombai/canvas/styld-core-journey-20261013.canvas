      "themeId": null,
      "rect": {
        "x": 1425,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n[data-name=\"phone-width layout shell\"] { height: 100dvh; min-height: 0; overflow: hidden; }\n[data-name=\"main content area\"] { min-height: 0; overflow-y: auto; overscroll-behavior: contain; }\n[data-name=\"bottom tab navigation bar\"] { position: static; }\n</style>\n<div class=\"min-h-screen bg-[var(--bg-page)] text-[var(--text-primary)]\" data-kid=\"1\" data-name=\"app page root with theme variables\" style=\"--bg-page:#FAF8F5;--bg-surface:#FFFFFF;--bg-surface-raised:#F4F1EC;--color-ink:#1D1D1B;--color-clay:#C0A090;--color-clay-text:#875945;--color-sage:#909888;--text-primary:#1D1D1B;--text-secondary:#4F4B48;--text-muted:#6E6966;--border-subtle:rgba(29,29,27,.12);--border-default:rgba(29,29,27,.22);--action-primary-bg:#1D1D1B;--action-primary-text:#FFFFFF;font-family:'DM Sans',Aptos,'Segoe UI',sans-serif;\">\n    <div class=\"mx-auto flex min-h-screen w-full max-w-[430px] flex-col\" data-kid=\"1-1\" data-name=\"phone-width layout shell\">\n        <header class=\"sticky top-0 z-30 border-b border-[var(--border-subtle)] bg-[var(--bg-page)]/95 px-4 py-3 backdrop-blur-md\" data-kid=\"1-1-1\" data-name=\"sticky top header bar\">\n            <div class=\"flex items-center justify-between\" data-kid=\"1-1-1-1\" data-name=\"header content row\">\n                <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo group\">\n                    <span class=\"flex h-9 w-9 items-center justify-center rounded-full border border-[var(--border-default)] bg-white text-[17px] font-semibold leading-none text-[var(--color-ink)]\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand monogram badge\">\n                        S\n                    </span>\n                    <div class=\"leading-tight\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand name stack\">\n                        <div class=\"text-[17px] font-semibold tracking-[-0.04em]\" data-kid=\"1-1-1-1-1-2-1\" data-name=\"brand name title\" style=\"font-family:'Playfair Display',Georgia,serif;\">\n                            Styld\n                            <span class=\"text-[var(--color-clay-text)]\" data-kid=\"1-1-1-1-1-2-1-1\" data-name=\"brand accent period\">\n                                .\n                            </span>\n                        </div>\n                        <div class=\"mt-0.5 text-[9px] font-semibold tracking-[0.13em] text-[var(--text-muted)]\" data-kid=\"1-1-1-1-1-2-2\" data-name=\"brand tagline text\">\n                            NAIROBI BEAUTY\n                        </div>\n                    </div>\n                </div>\n                <button class=\"inline-flex h-10 items-center gap-1.5 rounded-full border border-[var(--border-subtle)] bg-white px-3 text-[12px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-1-1-2\" data-name=\"location selector button\">\n                    <i class=\"icon-map-pin text-[14px] text-[var(--color-clay-text)]\" data-kid=\"1-1-1-1-2-1\" data-name=\"map pin icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-1-2-2\" data-name=\"selected location label\">\n                        Nairobi\n                    </span>\n                    <span class=\"ml-0.5 text-[var(--text-muted)]\" data-kid=\"1-1-1-1-2-3\" data-name=\"disclosure chevron glyph\">\n                        ⌄\n                    </span>\n                </button>\n            </div>\n        </header>\n        <main class=\"flex-1 px-4 pb-8 pt-5\" data-kid=\"1-1-2\" data-name=\"main content area\">\n            <div class=\"mb-4\" data-kid=\"1-1-2-1\" data-name=\"hero heading block\">\n                <h1 class=\"text-[29px] font-semibold leading-[1.08] tracking-[-0.04em] text-[var(--color-ink)]\" data-kid=\"1-1-2-1-1\" data-name=\"hero headline\" style=\"font-family:'Playfair Display',Georgia,serif;\">\n                    Find the look.\n                    <br data-kid=\"1-1-2-1-1-1\" data-name=\"headline line break\"/>\n                    Meet the maker.\n                </h1>\n                <p class=\"mt-2 max-w-[310px] text-[13px] leading-[1.5] text-[var(--text-secondary)]\" data-kid=\"1-1-2-1-2\" data-name=\"hero subheading text\">\n                    Browse the work first. Compare the service details before you book.\n                </p>\n            </div>\n            <nav aria-label=\"Discover sections\" class=\"mb-4 grid grid-cols-3 gap-1.5\" data-kid=\"1-1-2-2\" data-name=\"discover category tab bar\">\n                <button class=\"h-10 rounded-full bg-[var(--color-ink)] px-2 text-[12px] font-semibold text-white\" data-kid=\"1-1-2-2-1\" data-name=\"Looks tab button (active)\">\n                    Looks\n                </button>\n                <button class=\"h-10 rounded-full border border-[var(--border-subtle)] bg-white px-2 text-[12px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-2-2\" data-name=\"Salons tab button\">\n                    Salons\n                </button>\n                <button class=\"h-10 rounded-full border border-[var(--border-subtle)] bg-white px-2 text-[12px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-2-3\" data-name=\"Professionals tab button\">\n                    Professionals\n                </button>\n                <button class=\"h-10 rounded-full border border-[var(--border-subtle)] bg-white px-2 text-[12px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-2-4\" data-name=\"Services tab button\">\n                    Services\n                </button>\n                <button class=\"h-10 rounded-full border border-[var(--border-subtle)] bg-white px-2 text-[12px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-2-5\" data-name=\"Packages tab button\">\n                    Packages\n                </button>\n            </nav>\n            <label class=\"mb-3 flex h-11 items-center gap-2.5 rounded-xl border border-[var(--border-subtle)] bg-white px-3.5\" data-kid=\"1-1-2-3\" data-name=\"search field container\">\n                <i class=\"icon-search text-[17px] text-[var(--text-secondary)]\" data-kid=\"1-1-2-3-1\" data-name=\"search magnifier icon\">\n                </i>\n                <input aria-label=\"Search looks or professionals\" class=\"min-w-0 flex-1 bg-transparent text-[13px] text-[var(--text-primary)] outline-none placeholder:text-[var(--text-muted)]\" data-kid=\"1-1-2-3-2\" data-name=\"search input field\" placeholder=\"Search looks or professionals\"/>\n            </label>\n            <div class=\"mb-3 flex items-center justify-between gap-3\" data-kid=\"1-1-2-4\" data-name=\"filter row layout\">\n                <div class=\"flex min-w-0 gap-1.5 overflow-x-auto pb-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden\" data-kid=\"1-1-2-4-1\" data-name=\"horizontally scrollable chip list\">\n                    <button class=\"shrink-0 rounded-full bg-[var(--color-ink)] px-3 py-1.5 text-[11px] font-semibold text-white\" data-kid=\"1-1-2-4-1-1\" data-name=\"All chip (active)\">\n                        All\n                    </button>\n                    <button class=\"shrink-0 rounded-full border border-[var(--border-subtle)] bg-white px-3 py-1.5 text-[11px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-4-1-2\" data-name=\"Braids filter chip\">\n                        Braids\n                    </button>\n                    <button class=\"shrink-0 rounded-full border border-[var(--border-subtle)] bg-white px-3 py-1.5 text-[11px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-4-1-3\" data-name=\"Locs filter chip\">\n                        Locs\n                    </button>\n                    <button class=\"shrink-0 rounded-full border border-[var(--border-subtle)] bg-white px-3 py-1.5 text-[11px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-4-1-4\" data-name=\"Nails filter chip\">\n                        Nails\n                    </button>\n                    <button class=\"shrink-0 rounded-full border border-[var(--border-subtle)] bg-white px-3 py-1.5 text-[11px] font-medium text-[var(--text-secondary)]\" data-kid=\"1-1-2-4-1-5\" data-name=\"Make-up filter chip\">\n                        Make-up\n                    </button>\n                </div>\n                <button class=\"flex h-9 shrink-0 items-center gap-1.5 rounded-full border border-[var(--border-default)] bg-white px-3 text-[12px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-2-4-2\" data-name=\"filter button\">\n                    <i class=\"icon-sliders-horizontal text-[14px]\" data-kid=\"1-1-2-4-2-1\" data-name=\"sliders icon\">\n                    </i>\n                    Filter\n                </button>\n            </div>\n            <section aria-labelledby=\"work-heading\" class=\"mt-4\" data-kid=\"1-1-2-5\" data-name=\"browse the work section\">\n                <div class=\"mb-2 flex items-end justify-between\" data-kid=\"1-1-2-5-1\" data-name=\"section header row\">\n                    <h2 class=\"text-[16px] font-semibold tracking-[-0.02em]\" data-kid=\"1-1-2-5-1-1\" data-name=\"section title\" id=\"work-heading\">\n                        Browse the work\n                    </h2>\n                    <span class=\"text-[11px] text-[var(--text-muted)]\" data-kid=\"1-1-2-5-1-2\" data-name=\"section helper text\">\n                        Tap a photo to inspect\n                    </span>\n                </div>\n                <div class=\"-mx-4 flex gap-2.5 overflow-x-auto px-4 pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden\" data-kid=\"1-1-2-5-2\" data-name=\"horizontally scrolling carousel of look cards\">\n                    <button class=\"w-[128px] shrink-0 text-left\" data-kid=\"1-1-2-5-2-1\" data-name=\"Braids look card\">\n                        <img alt=\"Black woman with golden braids against a warm yellow background — Pexels / Kehinde Ogunsanya\" class=\"h-[124px] w-[128px] rounded-xl object-cover object-[center_28%]\" data-kid=\"1-1-2-5-2-1-1\" data-name=\"Braids look cover image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/11515382/pexels-photo-11515382.jpeg?auto=compress&cs=tinysrgb&w=560&h=680&fit=crop\"/>\n                        <span class=\"mt-1.5 block text-[12px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-2-5-2-1-2\" data-name=\"Braids look label\">\n                            Braids\n                        </span>\n                    </button>\n                    <button class=\"w-[128px] shrink-0 text-left\" data-kid=\"1-1-2-5-2-2\" data-name=\"Soft glam look card\">\n                        <img alt=\"Makeup artist applying eyeshadow on a Black woman — Pexels / Wayne Fotografias\" class=\"h-[124px] w-[128px] rounded-xl object-cover object-[center_42%]\" data-kid=\"1-1-2-5-2-2-1\" data-name=\"Soft glam look cover image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/11360229/pexels-photo-11360229.jpeg?auto=compress&cs=tinysrgb&w=560&h=680&fit=crop\"/>\n                        <span class=\"mt-1.5 block text-[12px] font-semibold text-[var(--text-primary)]\" data-kid=\"1-1-2-5-2-2-2\" data-name=\"Soft glam look label\">\n                            Soft glam\n                        </span>\n                    </button>\n                    <button class=\"w-[128px] shrink-0 text-left\" data-kid=\"1-1-2-5-2-3\" data-name=\"Loc care look card\">\n                        <img alt=\"Stylist braiding natural Black hair in a salon setting — Pexels / Planetelevene\" class=\"h-[124px] w-[128px] rounded-xl object-cover object-[center_45%]\" data-kid=\"1-1-2-5-2-3-1\" data-name=\"Loc care look cover image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.co