# Passwordless MVP: no Clerk, Africa's Talking, Twilio or paid phone authentication.
# Generate private random secrets. Set BETTER_AUTH_URL to the exact deployment origin.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
MFA_SECRET_KEY=
# Resend Free requires a verified domain (DNS setup). Do not enable paid upgrades.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional. Google OAuth requires configuration, not billing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Existing database and product integrations:
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CRON_SECRET=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
ENABLE_STRIPE_PAYMENTS=false
STRIPE_API_PUBLISHABLE_KEY=
STRIPE_API_SECRET_KEY=

# Enable only after Google OAuth has passed browser validation.
GOOGLE_AUTH_VERIFIED=false
