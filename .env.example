AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
# ==================================================
# CLERK AUTHENTICATION
# ==================================================
# ONLY these variables are read by @clerk/nextjs. Verified against the installed SDK:
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY  (required - identifies the Clerk instance)
#   CLERK_SECRET_KEY                   (required, server-side only)
#   CLERK_JWT_KEY                      (optional - enables networkless JWT verification)
#
# DO NOT add CLERK_FRONTEND_API / CLERK_BACKEND_API / CLERK_JWKS_URL /
# CLERK_JWKS_PUBLIC_KEY. The SDK does not read them; they only cause confusion.
# The frontend API host is already encoded in the publishable key, and the SDK
# derives the JWKS endpoint from it automatically.
#
# DEVELOPMENT vs PRODUCTION INSTANCE — CRITICAL:
#   pk_test_ / sk_test_  -> Clerk DEVELOPMENT instance (<slug>.clerk.accounts.dev).
#                           Works only for localhost and dev/preview. NOT for a
#                           public production domain.
#   pk_live_ / sk_live_  -> Clerk PRODUCTION instance on your own domain.
#                           REQUIRED before going live.
# Switching instances is a change of KEYS, not of code. Google OAuth credentials
# and every enabled sign-in method must be configured separately on the
# production instance (development settings do not carry over).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CRON_SECRET=
# ==================================================
# AUTHENTICATION SAFETY — MUST BE DISABLED IN PRODUCTION
# ==================================================
# AUTH_TEST_MODE=true generates dynamic verification codes shown directly in the
# UI and server console. It is for LOCAL DEVELOPMENT ONLY.
# The app already refuses test OTP when NODE_ENV=production unless
# AUTH_STAGING_MODE=true AND a phone allowlist is configured — but never rely on
# that guard alone: set these explicitly to false/empty in every deployed
# environment so production never depends on a safety net.
AUTH_TEST_MODE=false
AUTH_OTP_PROVIDER=

# ==================================================
# TWILIO & WHATSAPP AUTHENTICATION
# ==================================================
# Twilio Account identifier (starts with AC)
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000

# Recommended: Twilio API Key credentials (starts with SK)
TWILIO_API_KEY_SID=SK00000000000000000000000000000000
TWILIO_API_KEY_SECRET=

# Optional legacy fallback: Master Auth Token
TWILIO_AUTH_TOKEN=

# Twilio Verify Service SID (IMPORTANT: starts with VA, not SK)
TWILIO_VERIFY_SERVICE_SID=VA00000000000000000000000000000000

# WhatsApp authentication: Twilio Verify v2 with approved WhatsApp sender
# Uses Meta-approved WhatsApp authentication templates (with Copy Code button)
# Server-side only: never prefix with NEXT_PUBLIC_.
# Do not enable until Verify Service SID and WhatsApp sender are configured.
WHATSAPP_AUTH_ENABLED=false
# Set WHATSAPP_DEV_MODE=true to enable sandbox testing with code 123456 without Twilio fees.
WHATSAPP_DEV_MODE=false
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
RESEND_API_KEY=
RESEND_API_URL=
RESEND_FROM_EMAIL=notifications@styld.co.ke
ENABLE_STRIPE_PAYMENTS=false
STRIPE_API_PUBLISHABLE_KEY=
STRIPE_API_SECRET_KEY=

# Admin account setup (required for initial admin account creation)
# SECURITY: These should be set in production environment, never committed to git
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSCODE=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
