# Passwordless MVP: no Clerk, Africa's Talking, Twilio or paid phone authentication.
# Generate private random secrets. Set BETTER_AUTH_URL to the exact deployment origin.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
MFA_SECRET_KEY=
# Secret allowed to read the email health check. Leave empty to disable (404).
HEALTH_CHECK_TOKEN=
# Resend Free requires a verified domain (DNS setup). Do not enable paid upgrades.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional Gmail transport. Enter the App Password only in deployment secrets.
EMAIL_PROVIDER=resend
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional. Google OAuth requires configuration, not billing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Existing database and product integrations:
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
CRON_SECRET=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
ENABLE_STRIPE_PAYMENTS=false
STRIPE_API_PUBLISHABLE_KEY=
STRIPE_API_SECRET_KEY=

# Enable only after Google OAuth has passed browser validation.
GOOGLE_AUTH_VERIFIED=false
# Pending media uploads are refused by the server until one of the two acts below is taken.
# Restricted delivery: set the signing key, the single delivery origin and the bounds, then
# attest that the Cloudinary folder itself is not publicly readable.
CLOUDINARY_SIGN_KEY=
STYLD_RESTRICTED_MEDIA_ENABLED=false
# Token delivery requires the provider's token support. Private download uses expiring API signatures.
STYLD_MEDIA_SIGNING_MODE=token
# Operator canary is off unless this is a current ISO timestamp, on the test-branch Preview only.
STYLD_MEDIA_VERIFICATION_STARTED_AT=
STYLD_MEDIA_ALLOWED_ORIGINS=
STYLD_MEDIA_MAX_BYTES=5242880
STYLD_MEDIA_TIMEOUT_MS=5000
STYLD_MEDIA_ACCESS_WINDOW_SECONDS=300
STYLD_MEDIA_PROVIDER_RESTRICTION_VERIFIED=false
# Or declare that this environment holds no private images at all, for local development only.
STYLD_MEDIA_UPLOADS_UNRESTRICTED=false
